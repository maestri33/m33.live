{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "m33-live",
  "main": "@astrojs/cloudflare/entrypoints/server",
  "compatibility_date": "2026-11-19",
  "compatibility_flags": ["global_fetch_strictly_public"],
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist"
  },
  "routes": [
    {
      "pattern": "m33.live",
      "custom_domain": true
    },
    {
      "pattern": "www.m33.live",
      "custom_domain": true
    }
  ],
  "observability": {
    "enabled": true
  }
}
